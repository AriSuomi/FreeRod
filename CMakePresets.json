{
  "version": 3,
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC x64 (Ninja Multi-Config, vcpkg)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/msvc",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "mingw-gcc",
      "displayName": "MinGW GCC x64 (Ninja Multi-Config, vcpkg)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/gcc",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
      }
    },
    {
      "name": "mingw-clang",
      "displayName": "MinGW Clang x64 (Ninja Multi-Config, vcpkg)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/clang",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
      }
    },
    {
      "name": "gcc",
      "displayName": "GCC (Ninja Multi-Config)",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/gcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "clang",
      "displayName": "Clang (Ninja Multi-Config)",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "mingw-gcc-debug", "configurePreset": "mingw-gcc", "configuration": "Debug" },
    { "name": "mingw-gcc-release", "configurePreset": "mingw-gcc", "configuration": "Release" },
    { "name": "mingw-clang-debug", "configurePreset": "mingw-clang", "configuration": "Debug" },
    { "name": "mingw-clang-release", "configurePreset": "mingw-clang", "configuration": "Release" },
    { "name": "gcc-debug", "configurePreset": "gcc", "configuration": "Debug" },
    { "name": "gcc-release", "configurePreset": "gcc", "configuration": "Release" },
    { "name": "clang-debug", "configurePreset": "clang", "configuration": "Debug" },
    { "name": "clang-release", "configurePreset": "clang", "configuration": "Release" }
  ]
}
